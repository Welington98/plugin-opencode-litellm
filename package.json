{
  "name": "@welington98/opencode-litellm",
  "version": "1.0.2",
  "description": "OpenCode plugin/provider for LiteLLM Proxy — configure endpoint + API key inside OpenCode and auto-discover authorized models.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Welington98/plugin-opencode-litellm.git"
  },
  "homepage": "https://github.com/Welington98/plugin-opencode-litellm#readme",
  "bugs": {
    "url": "https://github.com/Welington98/plugin-opencode-litellm/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/server.js",
  "types": "./dist/types.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "default": "./dist/server.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/server.ts --outdir dist --target bun && bun build ./src/tui.tsx --outdir dist --target bun --external '@opentui/*' --external 'solid-js' --external '@opencode-ai/plugin' --external '@opencode-ai/sdk' && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "opencode",
    "plugin",
    "litellm",
    "llm",
    "ai-gateway",
    "provider"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.18",
    "@opencode-ai/sdk": "^1.18.18"
  },
  "devDependencies": {
    "@opentui/core": "^0.5.2",
    "@opentui/solid": "^0.5.2",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
